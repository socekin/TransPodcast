<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.transpodcast.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TRANSPODCAST_ROOT__/.venv/bin/transpodcast-api</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TRANSPODCAST_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__TRANSPODCAST_PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__TRANSPODCAST_ROOT__/data/logs/api.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__TRANSPODCAST_ROOT__/data/logs/api.stderr.log</string>
</dict>
</plist>
