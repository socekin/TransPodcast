{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transpodcast-publication",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "podcasts.example.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "private-transpodcast",
      "preview_bucket_name": "private-transpodcast-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
