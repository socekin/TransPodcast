TRANSPODCAST_DATABASE_PATH=data/transpodcast.sqlite3
TRANSPODCAST_ARTIFACT_ROOT=data/artifacts
TRANSPODCAST_SHOW_ARTWORK_PATH=apps/owner-console/public/assets/transpodcast-artwork.png
TRANSPODCAST_SHOW_TITLE=TransPodcast
TRANSPODCAST_SHOW_DESCRIPTION=Private complete Mandarin podcast editions.
TRANSPODCAST_SHOW_AUTHOR=TransPodcast
TRANSPODCAST_OWNER_CONSOLE_DIST=apps/owner-console/dist/client
TRANSPODCAST_LOCAL_STORAGE_ROOT=data/object-storage
TRANSPODCAST_PUBLICATION_DOMAIN=http://transpodcast.localhost:8000
TRANSPODCAST_FEED_TOKEN=
TRANSPODCAST_FEED_TOKEN_PATH=data/secrets/feed-token

# Agent CLIs. Codex is the default Agent provider; Claude Code is optional and
# is selected in Settings. Empty model and effort values use the CLI defaults.
TRANSPODCAST_CODEX_EXECUTABLE=codex
TRANSPODCAST_CODEX_MODEL=
TRANSPODCAST_CLAUDE_EXECUTABLE=claude
TRANSPODCAST_CLAUDE_MODEL=
# One of low, medium, high, xhigh, or max; leave empty for the CLI default.
TRANSPODCAST_CLAUDE_EFFORT=

TRANSPODCAST_YOUTUBE_PROXY_URL=
# A local Chromium-based browser generates YouTube proof-of-origin tokens for
# source media downloads.
TRANSPODCAST_YOUTUBE_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

TRANSPODCAST_MODAL_COMMAND=uv run transpodcast-modal-pipeline
TRANSPODCAST_MODAL_ENVIRONMENT=transpodcast
# Modal Account credit routing (optional). To enable, point
# TRANSPODCAST_MODAL_COMMAND at "uv run transpodcast-modal-router" and list the
# Modal profiles from ~/.modal.toml in priority order. Remaining monthly
# credit below the threshold skips an account; with no eligible account the
# Spend Guardrail pause and Owner Notification apply.
# TRANSPODCAST_MODAL_COMMAND=uv run transpodcast-modal-router
# TRANSPODCAST_MODAL_PROFILES=transpodcast-primary,transpodcast-secondary
# TRANSPODCAST_MODAL_CREDIT_THRESHOLD_USD=2
# TRANSPODCAST_MODAL_MONTHLY_ALLOWANCE_USD=30
TRANSPODCAST_MODAL_L40S_USD_PER_HOUR=1.95
TRANSPODCAST_SPEAKER_MATCH_POLICY_VERSION=channel-speaker-match-v1
TRANSPODCAST_SPEAKER_MATCH_MINIMUM_ANALYSIS_CONFIDENCE=0.9
TRANSPODCAST_SPEAKER_MATCH_MINIMUM_SIMILARITY=0.9

TRANSPODCAST_STORAGE_MODE=local
# The R2 settings below are required only when TRANSPODCAST_STORAGE_MODE=r2.
TRANSPODCAST_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
TRANSPODCAST_R2_BUCKET=private-transpodcast
TRANSPODCAST_R2_ACCESS_KEY_ID=
TRANSPODCAST_R2_SECRET_ACCESS_KEY=

TRANSPODCAST_TELEGRAM_BOT_TOKEN=
TRANSPODCAST_TELEGRAM_OWNER_CHAT_ID=
